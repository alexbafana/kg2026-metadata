{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexbafana/kg2026-metadata#schema//validation-report/1.0.0",
  "title": "Acceptance validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "run_id", "decision", "checks"],
  "properties": {
    "record_id": {"type": "string"},
    "run_id": {"type": "string"},
    "decision": {"enum": ["accepted", "conditional", "rejected"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "status", "severity", "evidence"],
        "properties": {
          "rule_id": {"type": "string"},
          "status": {"enum": ["pass", "fail"]},
          "severity": {"enum": ["reject", "conditional"]},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
