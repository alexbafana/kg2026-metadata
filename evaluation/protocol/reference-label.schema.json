{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/kg2026/schema/reference-label/1.0.0",
  "title": "Human-reviewed employment reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "event_type", "job_count", "organization", "evidence_span", "reviewers", "review_status"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["job_gain", "job_loss", "no_event", "ambiguous"]},
    "job_count": {"type": ["integer", "null"], "minimum": 0},
    "organization": {"type": ["string", "null"]},
    "evidence_span": {"type": ["string", "null"]},
    "reviewers": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "review_status": {"enum": ["agreed", "resolved_disagreement", "unresolved"]},
    "resolution_note": {"type": "string"}
  }
}
