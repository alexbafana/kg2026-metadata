PREFIX ex: <https://github.com/alexbafana/kg2026-metadata#schema/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX ver: <https://github.com/alexbafana/kg2026-metadata#version/>

SELECT ?assertion ?source ?sourceHash ?run ?trajectory
       ?step ?position ?stage ?mode ?model ?modelVersion
       ?contract ?decision ?outcome
WHERE {
  ?assertion a ex:EmploymentAssertion ;
             prov:wasDerivedFrom ?source ;
             prov:wasGeneratedBy ?run ;
             ver:hasProcessingTrajectory ?trajectory ;
             ex:governedBy ?contract ;
             ex:validatedBy ?decision .
  ?source ex:sha256 ?sourceHash .
  ?run ex:usedModel ?model .
  ?model <http://purl.org/dc/terms/hasVersion> ?modelVersion .
  ?trajectory ex:hasStep ?step .
  ?step ex:position ?position ;
        ex:stage ?stage ;
        ex:mode ?mode .
  ?decision ex:outcome ?outcome .
}
ORDER BY ?assertion ?position
